		"lightning_clam":
			points = [[-77,47],[-98,15],[-95,-14],[-80,-35],[-68,-23],[-58,-53],[-39,-62],[-25,-42],[-13,-72],[10,-75],[26,-47],[42,-65],[61,-53],[69,-26],[85,-35],[99,-12],[98,17],[77,47],[40,62],[0,53],[-40,62]]
		_:
			return PackedVector2Array()
	var raw := PackedVector2Array()
	for point: Array in points:
		raw.append(Vector2(float(point[0]),float(point[1])))
	return _normalized(_resample(raw,240))

static func _resample(raw: PackedVector2Array, count: int) -> PackedVector2Array:
	var lengths := PackedFloat32Array([0.0])
	var total := 0.0
	for i in range(raw.size()):
		total += raw[i].distance_to(raw[(i+1)%raw.size()])
		lengths.append(total)
	var result := PackedVector2Array()
	var segment := 0
	for i in range(count):
		var distance: float = total*float(i)/float(count)
		while segment+1 < lengths.size()-1 and lengths[segment+1] < distance:
			segment += 1
		var fraction := (distance-lengths[segment])/maxf(.001,lengths[segment+1]-lengths[segment])
		result.append(raw[segment].lerp(raw[(segment+1)%raw.size()],fraction))
	result.append(result[0])
	return result

static func _normalized(raw: PackedVector2Array) -> PackedVector2Array:
	var low := Vector2(INF,INF)
	var high := Vector2(-INF,-INF)
	for point in raw:
		low = low.min(point)
		high = high.max(point)
	var span := high-low
	var extent: float = maxf(span.x,span.y)
	for i in range(raw.size()):
		raw[i] = (raw[i]-(low+high)*.5)/extent
	return raw
