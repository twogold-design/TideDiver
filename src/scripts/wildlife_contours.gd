		"marine_ShoreCrab":
			points = [[-28,-36],[-45,-61],[-35,-84],[-60,-71],[-67,-44],[-46,-20],[-62,-9],[-96,-24],[-77,0],[-58,6],[-96,14],[-75,27],[-55,20],[-83,43],[-59,43],[-38,29],[-20,38],[20,38],[38,29],[59,43],[83,43],[55,20],[75,27],[96,14],[58,6],[77,0],[96,-24],[62,-9],[46,-20],[67,-44],[60,-71],[35,-84],[45,-61],[28,-36]]
		"marine_SeaUrchin":
			for i in range(40):
				var angle: float = -PI*.5+float(i)*TAU/40.0
				var radius: float = 82.0 if i%2==0 else 57.0
				points.append([cos(angle)*radius,sin(angle)*radius])
		"marine_SeaCucumber":
